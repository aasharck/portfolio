# Copy to .env.local. Every variable is optional: with none set, the site runs in
# mock mode ($0, labelled on every answer).

# --- Live mode needs BOTH the API key and the Upstash store ------------------
# Anthropic API key. Without it: mock mode.
ANTHROPIC_API_KEY=
# Upstash Redis (REST). Holds the daily budget, rate limits and answer cache.
# Live mode stays off without these, because a per-instance counter can't enforce a budget.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cost guardrails (defaults shown) ----------------------------------------
# Hard cap on model spend per UTC day, in USD.
DAILY_BUDGET_USD=0.50
# Requests per network (hashed IP) per 10 minutes.
RATE_ASK_PER_10MIN=12
RATE_FIT_PER_10MIN=4
# Longest job description accepted, in characters.
MAX_JD_CHARS=8000
# Salt for hashing IPs before they are used as rate-limit keys. Set any random string.
IP_SALT=

# --- Models (defaults from the claude-api skill, Oct 2026) -------------------
# Chat: the cheapest current model.
CHAT_MODEL=claude-haiku-5-5
# Fit check, step 1 (requirement extraction).
EXTRACT_MODEL=claude-haiku-5-5
# Fit check, step 2 (judging evidence). Stronger model; the report is the product.
REPORT_MODEL=claude-sonnet-5-5

# --- Misc ---------------------------------------------------------------------
# Force mock mode even with a key (e.g. for screenshots or e2e tests).
MOCK_LLM=
# Public URL, for metadata and Open Graph.
NEXT_PUBLIC_SITE_URL=https://aashar.vercel.app
